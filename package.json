    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "music-metadata": "^11.0.0",
    "sharp": "^0.35.4"
  },
  "files": [
    "src",
    "public",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
